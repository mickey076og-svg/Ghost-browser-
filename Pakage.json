  },
  "dependencies": {
    "next": "14.2.0",
    "react": "18.3.0",
    "react-dom": "18.3.0",
    "@cliqz/adblocker-electron": "1.34.0",
    "cross-fetch": "4.0.0",
    "electron-serve": "1.1.0"
  },
  "devDependencies": {
    "electron": "28.0.0",
    "electron-builder": "24.9.1"
  },
  "build": {
    "appId": "com.mickey.ghostbrowser",
    "productName": "Ghost Browser",
    "icon": "icon.png",
    "files": [
      "out/**/*",
      "main.js",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
