{
  "name": "ghost-browser",
  "version": "1.0.0",
  "description": "Ghost Browser - Ad Free, fast browser for Kenya",
  "main": "main.js",
  "author": "mickey076gog-svg",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build && next export",
    "electron": "electron .",
    "dist:win": "next build && electron-builder --win",
