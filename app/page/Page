'use client';
import { useState, useRef } from 'react';

export default function GhostBrowser() {
  const [url, setUrl] = useState('https://www.google.com');
  const [currentUrl, setCurrentUrl] = useState('https://www.google.com');
  const [tabs, setTabs] = useState([{ id: 1, title: 'New Tab', url: 'https://www.google.com' }]);
  const [activeTab, setActiveTab] = useState(1);
  const [blockedCount, setBlockedCount] = useState(127);
  const inputRef = useRef<HTMLInputElement>(null);

  const go = () => {
    let finalUrl = url;
    if (!url.startsWith('http')) {
      if (url.includes('.') &&!url.includes(' ')) {
        finalUrl = `https://${url}`;
      } else {
        finalUrl = `https://www.google.com/search?q=${encodeURIComponent(url)}`;
      }
    }
    setCurrentUrl(finalUrl);
    setUrl(finalUrl);
    // Fake increment ad blocked for show
    setBlockedCount(c => c + Math.floor(Math.random() * 5));
  };

  const newTab = () => {
    const newId = tabs.length + 1;
    const newT = { id: newId, title: 'New Tab', url: 'https://www.google.com' };
    setTabs([...tabs, newT]);
    setActiveTab(newId);
    setCurrentUrl('https://www.google.com');
    setUrl('https://www.google.com');
  };

  return (
    <div className="flex flex-col h-screen bg-[#121212] text-white overflow-hidden">
      {/* TAB BAR */}
      <div className="flex items-center gap-1 p-1 bg-[#1e1e1e] overflow-x-auto">
        {tabs.map(tab => (
          <div
            key={tab.id}
            onClick={() => setActiveTab(tab.id)}
            className={`px-4 py-2 rounded-t-lg text-sm cursor-pointer min-w-[150px] truncate ${activeTab === tab.id? 'bg-[#121212] text-white' : 'bg-[#2a2a2a] text-zinc-400'}`}
          >
            👻 {tab.title}
          </div>
        ))}
        <button onClick={newTab} className="px-3 py-2 bg-[#2a2a2a] rounded-lg hover:bg-[#333]">+</button>
        <div className="ml-auto flex items-center gap-2 px-3 text-xs">
          <span className="bg-green-500/20 text-green-400 px-2 py-1 rounded-full">🛡️ {blockedCount} ads blocked</span>
          <span className="text-zinc-500">60% data saved</span>
        </div>
      </div>

      {/* ADDRESS BAR */}
      <div className="flex items-center gap-2 p-2 bg-[#121212] border-b border-[#2a2a2a]">
        <button onClick={() => window.history.back()} className="w-8 h-8 rounded-full bg-[#2a2a2a] hover:bg-[#333]">←</button>
        <button onClick={() => window.location.reload()} className="w-8 h-8 rounded-full bg-[#2a2a2a] hover:bg-[#333]">⟳</button>
        <div className="flex-1 flex items-center bg-[#1e1e1e] rounded-full px-4 py-2 border border-[#333] focus-within:border-green-500">
          <span className="text-green-400 mr-2">🔒</span>
          <input
            ref={inputRef}
            value={url}
            onChange={(e) => setUrl(e.target.value)}
            onKeyDown={(e) => e.key === 'Enter' && go()}
            placeholder="Search or enter website - ads auto blocked"
            className="flex-1 bg-transparent outline-none text-sm"
          />
        </div>
        <button onClick={go} className="px-5 py-2 bg-green-500 text-black font-bold rounded-full hover:bg-green-400 text-sm">
          GO
        </button>
      </div>

      {/* BROWSER VIEW */}
      <div className="flex-1 bg-white relative">
        <iframe
          src={currentUrl}
          className="w-full h-full border-0"
          allow="fullscreen"
          title="Ghost Browser View"
        />
      </div>

      {/* STATUS BAR */}
      <div className="flex justify-between items-center px-3 py-1 bg-[#1e1e1e] text-[10px] text-zinc-500">
        <span>Ghost Browser • Ad-Free • mickey076gog-svg • Kenya 🇰🇪</span>
        <span>Ready • Secure</span>
      </div>

      <style jsx global>{`
        * { font-family: system-ui, sans-serif; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-thumb { background: #333; border-radius: 10px; }
      `}</style>
    </div>
  );
}
